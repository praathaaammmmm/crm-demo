{
  "name": "crm",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc -b apps/api && npm run build -w @crm/web",
    "typecheck": "tsc -b apps/api && npm run typecheck -w @crm/web",
    "lint": "eslint .",
    "format": "prettier --write apps packages docs README.md",
    "format:check": "prettier --check apps packages docs README.md",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:migrate": "npm run migrate -w @crm/database",
    "bootstrap": "npm run bootstrap -w @crm/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
