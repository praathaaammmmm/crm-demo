{
  "name": "@crm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b -w",
    "dev:server": "node --env-file-if-exists=../../.env --watch dist/src/server.js",
    "dev:worker": "node --env-file-if-exists=../../.env --watch dist/src/worker.js",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "bootstrap": "node --env-file-if-exists=../../.env dist/src/bootstrap.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@crm/contracts": "*",
    "@crm/database": "*",
    "@crm/permissions": "*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
