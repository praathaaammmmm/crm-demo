# Web app environment. Copy to apps/web/.env.local and set real values.
# Server-side only: not exposed to the browser (no NEXT_PUBLIC_ prefix).
# The web app needs no database credentials, passwords, or other secrets.

# Where the Next.js server reaches the API (used for /api/v1 rewrites and server-side reads).
API_INTERNAL_URL=http://localhost:4000
