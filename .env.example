# Copy to .env and replace every placeholder. Never commit real values.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Web and API
APP_ORIGIN=http://localhost:3000
API_PORT=4000
# Deployed hosts may provide PORT instead; the API uses it when API_PORT is unset.
API_INTERNAL_URL=http://localhost:4000
ORG_TIMEZONE=Asia/Kolkata

# Local PostgreSQL role passwords (used only by the local database setup)
POSTGRES_PASSWORD=change-me-postgres
CRM_MIGRATOR_PASSWORD=change-me-migrator
CRM_APP_PASSWORD=change-me-app
CRM_WORKER_PASSWORD=change-me-worker

# Database connections, one per least-privilege role
DATABASE_URL_MIGRATOR=postgres://crm_migrator:change-me-migrator@localhost:5432/crm
DATABASE_URL_APP=postgres://crm_app:change-me-app@localhost:5432/crm
DATABASE_URL_WORKER=postgres://crm_worker:change-me-worker@localhost:5432/crm

# Tests only: local superuser that creates and drops per-test databases
TEST_DATABASE_ADMIN_URL=postgres://postgres:change-me-postgres@localhost:5432/postgres

# One-time Super Admin bootstrap (the password is entered at a hidden prompt, never here)
BOOTSTRAP_ADMIN_EMAIL=ceo@example.com
BOOTSTRAP_ADMIN_NAME=Placeholder Name

# Public read-only portfolio demo only. Leave unset (or false) everywhere else.
# API and web: "true" refuses every write except sign-in and sign-out, and shows the demo banner.
DEMO_MODE=false
# Web (server-side) only: the shared demo password shown on the login page. Must equal the seed password.
DEMO_LOGIN_PASSWORD=
# Seed only (npm run demo:seed -w @crm/api): never set on the running API or web app.
DEMO_SEED_CONFIRM=crm_demo
DEMO_ACCOUNT_PASSWORD=
